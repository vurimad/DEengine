# Build output
/build/
/out/

# Cooked data and ship layout: rebuilt by the cooker, never committed (each project's cooked/)
/projects/*/cooked/
/Archives/
*.arc

# The game's project is private (real maps, store assets) and versioned apart, not in the engine's public repository;
# only the sandbox project (the test scene) is committed here.
/projects/dreadworld/

# vcpkg
/vcpkg_installed/

# IDE and per-user settings
/.vs/
/.vscode/
/.idea/
CMakeUserPresets.json
*.user

# Captures, profiles, logs
*.rdc
*.tracy
*.log

# Python caches (tools/worldgen)
__pycache__/

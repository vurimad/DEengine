{
  // Late afternoon: a low gold sun ahead and to the left of the camp, cool shadows.
  "sun": {"elevation_deg": 19, "azimuth_deg": 324, "color": [1, 0.783, 0.522], "intensity": 4.6},
  "sky": {"color": [0.30, 0.40, 0.62], "intensity": 1},
  "ground": {"color": [0.12, 0.10, 0.07], "intensity": 1},
  "shadow_color": [0.05, 0.06, 0.09],
  "exposure_ev": 0,
  "shadows": {
    "resolution": 2048,        // per cascade
    "distance_m": 140,         // along the view
    "split_lambda": 0.75,      // 0: even cascades, 1: logarithmic
    "blend_band": 0.12,        // of each cascade, dithered into the next
    "caster_reach_m": 200,     // how far toward the sun casters are caught
    "penumbra_per_m": 0.06,    // penumbra width per meter between occluder and receiver
    "max_penumbra_texels": 6
  },
  "fog": {
    "density_per_m": 0.000005,            // everywhere, per meter: a trace, so the zenith stays clear
    "height_density_per_m": 0.0008,       // at base_height_m, per meter: haze over the land
    "height_falloff_per_m": 0.01,         // per meter: it thins by e every 100 m up
    "base_height_m": 0,
    "extinction_tint": [0.8, 1.0, 1.3],                       // blue fades first: the light through it warms
    "sun_forward": {"color": [1, 0.85, 0.7], "intensity": 0.25},  // looking toward the sun, times its colour
    "sun_back": {"color": [0.5, 0.6, 0.8], "intensity": 0.08},   // looking away from it
    "sun_height_attenuation": 1,
    "ambient": {"color": [0.30, 0.40, 0.62], "intensity": 1},  // the sky's light, scattered in from all around
    "ambient_height_attenuation": 1,
    "start_m": 0,
    "sun_start_m": 5,               // no sun haze on the camera's nose
    "end_m": 20000,                 // the sky is this far
    "volume_distance_m": 128        // the froxel grid's reach, for the sun's shadows in the fog; 0: none
  }
}

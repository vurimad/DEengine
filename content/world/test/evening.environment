{
  // Late afternoon: a low gold sun ahead and to the left of the camp, cool shadows.
  "sun": {"elevation_deg": 19, "azimuth_deg": 324, "color": [1, 0.783, 0.522], "intensity": 4.6},
  "sky": {"color": [0.30, 0.40, 0.62], "intensity": 1},
  "ground": {"color": [0.12, 0.10, 0.07], "intensity": 1},
  "shadow_color": [0.05, 0.06, 0.09],
  "exposure_ev": 0,
  "shadows": {
    "resolution": 2048,        // per cascade
    "distance_m": 140,         // along the view
    "split_lambda": 0.75,      // 0: even cascades, 1: logarithmic
    "blend_band": 0.12,        // of each cascade, dithered into the next
    "caster_reach_m": 200,     // how far toward the sun casters are caught
    "penumbra_per_m": 0.06,    // penumbra width per meter between occluder and receiver
    "max_penumbra_texels": 6
  }
}

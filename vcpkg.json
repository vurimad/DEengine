{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "deengine",
  "version": "0.1.0",
  "builtin-baseline": "9a5dfef5d1a0438a7d24856a85bd60f309d355e9",
  "dependencies": [
    "bc7enc-rdo",
    "cgltf",
    "doctest",
    "flecs",
    "glm",
    {
      "name": "imgui",
      "features": [
        "docking-experimental"
      ]
    },
    "meshoptimizer",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        "vulkan",
        {
          "name": "x11",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    "shader-slang",
    "stb",
    {
      "name": "tracy",
      "default-features": false,
      "features": [
        "on-demand"
      ]
    },
    "ufbx",
    "vk-bootstrap",
    "volk",
    "vulkan-headers",
    "vulkan-memory-allocator",
    "xxhash",
    "yyjson"
  ]
}
